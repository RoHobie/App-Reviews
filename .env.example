# Core LLM Provider Configuration (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
LLM_MODEL=gemini-3.8-flash
LLM_SUMMARY_MODEL=

# Rate Limiting & Delays (seconds between batches / calls)
LLM_BATCH_DELAY_SECONDS=1.0
MAX_LLM_CONCURRENCY=2

# Storage and Runtime
DATA_DIR=/app/data
LOG_LEVEL=INFO
PORT=8000
